# ---- Supabase ----
# Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key: server-only, NEVER expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Site ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_STORE_NAME="Mallu Auto Lab"
NEXT_PUBLIC_WHATSAPP_NUMBER=91XXXXXXXXXX

# ---- Razorpay ----
# Dashboard > Settings > API Keys
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
# Dashboard > Settings > Webhooks (create endpoint /api/webhooks/razorpay)
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# ---- Resend ----
RESEND_API_KEY=re_xxxxxxxxxxxx
# Must be a verified domain/sender in Resend
RESEND_FROM_EMAIL="Mallu Auto Lab <orders@yourdomain.com>"
ADMIN_NOTIFICATION_EMAIL=projectpmna1@gmail.com

# ---- Seed script only (scripts/seed.ts) ----
SOURCE_STORE_URL=https://malluautolab.com
